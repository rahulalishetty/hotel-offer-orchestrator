{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Hotel offer aggregation service using Node.js, TypeScript, Express, Temporal and Redis",
  "scripts": {
    "dev:api": "tsx src/server.ts",
    "dev:worker": "tsx src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@temporalio/client": "1.13.0",
    "@temporalio/worker": "1.13.0",
    "@temporalio/workflow": "1.13.0",
    "express": "5.1.0",
    "ioredis": "5.6.1",
    "pino": "9.7.0",
    "pino-http": "10.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.15.21",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
